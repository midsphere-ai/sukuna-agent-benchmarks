# Used by the reasoning, vision, search and browser tool servers
GRADIENT_API_KEY=""
GRADIENT_BASE_URL="https://inference.do-ai.run/v1"

# Audio tool server
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# YouTube analysis in the vision tool server
GEMINI_API_KEY=""

# Code sandbox
E2B_API_KEY=""
E2B_TEMPLATE_ID=""

# Search
SERPER_API_KEY=""
JINA_API_KEY=""
SEARXNG_URL="http://localhost:8888"
PERPLEXICA_MODEL=""
PERPLEXICA_FAST_MODEL=""

# Browser
CHROME_PATH=""
CHROME_USER_PROFILE_DIR=""

# Vertex AI (only when MODEL_PROVIDER="vertex"): base64 service-account JSON, or a file path
GOOGLE_SERVICE_ACCOUNT_B64=""
