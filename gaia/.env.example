# Main agent model (any OpenAI-compatible endpoint)
API_KEY=""
API_BASE="https://inference.do-ai.run/v1"
MODEL_NAME="anthropic-claude-opus-4.7"
# openrouter | vertex | azure
MODEL_PROVIDER="openrouter"

# Model used for question hints and final answer extraction
OPENAI_API_KEY=""
REASONING_MODEL_NAME="openai-gpt-5.5"
